#!/usr/bin/env bash
# lufs-recorder-pwa — fail-closed artifact verifier.
# "Exit 0 is not enough": prove the servable bytes are correct before they ship.
# Aligned to agent-knowledge docs/infra/website-portability (Required verification).
# Usage: scripts/verify [DIR]   (DIR defaults to repo root)
set -euo pipefail

DIR="${1:-.}"
MARKER="lufs-recorder"
MAX_BYTES=26214400   # 25 MiB (site.yaml runtime.max_asset_bytes)
REQUIRED=(index.html 404.html manifest.webmanifest sw.js icons/icon.svg)

fail=0
pass(){ printf '  ok    %s\n' "$1"; }
bad(){  printf '  FAIL  %s\n' "$1"; fail=$((fail+1)); }

echo "verify: $DIR"

# 1. required files exist and are non-empty
for f in "${REQUIRED[@]}"; do
  if [ -s "$DIR/$f" ]; then pass "exists non-empty: $f"; else bad "missing/empty: $f"; fi
done

# 2. HTML entry points parse (doctype + closing tag) and carry the content marker
# NB every file read below is guarded with `[ -f ]`. Under `set -e`, a redirect
# from a missing file aborts the whole script — which previously meant one
# absent asset skipped every remaining check and never printed the summary. A
# verifier that stops early is a verifier that lies about coverage.
for f in index.html 404.html; do
  if [ ! -f "$DIR/$f" ]; then bad "html missing: $f"
  elif grep -qi '<!doctype html>' "$DIR/$f" && grep -qi '</html>' "$DIR/$f"; then pass "html well-formed: $f"
  else bad "html not well-formed: $f"; fi
done
if [ -f "$DIR/index.html" ] && grep -q "$MARKER" "$DIR/index.html"; then pass "content marker present: $MARKER"
else bad "content marker missing: $MARKER"; fi

# 3. manifest is valid JSON with required keys, and start_url/scope are relative
if [ ! -f "$DIR/manifest.webmanifest" ]; then bad "manifest missing"; else
python3 - "$DIR/manifest.webmanifest" <<'PY' && pass "manifest valid + relative" || bad "manifest invalid"
import json,sys
m=json.load(open(sys.argv[1]))
assert m.get("name"), "name"
assert m.get("icons"), "icons"
assert str(m.get("start_url","")).startswith("."), "start_url must be relative"
assert str(m.get("scope","./")).startswith("."), "scope must be relative"
PY
fi

# 4. service worker bumps a cache name (stale-logic guard)
if [ -f "$DIR/sw.js" ] && grep -qE "const CACHE\s*=\s*'lufs-rec-v[0-9]" "$DIR/sw.js"; then pass "sw cache versioned"
else bad "sw.js missing versioned CACHE const"; fi

# 5. declared-origins gate (site/external-origins.yaml is the single source of truth).
# Extract every absolute-URL resource reference from index.html, reduce each to its
# scheme://host origin, and fail on any origin not declared in the YAML list. The
# declaration is the contract; this check must never carry its own hardcoded list.
# NB guarded with `if ... then/else` on purpose: under `set -e` a bare failing
# command aborts the run, which skips every later check and never prints the
# summary — a verifier that stops early is a verifier that lies about coverage.
ORIGINS_YAML="$(cd "$(dirname "$0")/.." && pwd)/site/external-origins.yaml"
if python3 - "$DIR/index.html" "$ORIGINS_YAML" <<'PY'
import sys, re, os

html_path, yaml_path = sys.argv[1], sys.argv[2]
html = open(html_path, encoding="utf-8").read()

def to_origin(url):
    m = re.match(r"(https?://[^/]+)", url)
    return m.group(1) if m else None

# Declared origins. A missing or empty declaration means nothing is allowed, so an
# undeclared origin still fails: the gate fails closed, never open.
declared = set()
if os.path.exists(yaml_path):
    for line in open(yaml_path, encoding="utf-8"):
        m = re.match(r"\s*-\s*(?:url:\s*)?(https?://\S+)", line)
        if m:
            o = to_origin(m.group(1).strip("'\""))
            if o:
                declared.add(o)
else:
    sys.stdout.write("        (no external-origins.yaml found; nothing is declared)\n")

# Resource references only. An <a href> a visitor clicks is not a dependency, but
# src/href on a fetching element, a srcset candidate, and a CSS url() all are.
found = set()
for u in re.findall(r'(?:src|href)=["\x27](https?://[^"\x27\s]+)', html):
    found.add(to_origin(u))
for attr in re.findall(r'srcset=["\x27]([^"\x27]+)', html):
    for cand in attr.split(","):
        cand = cand.strip().split()[0] if cand.strip() else ""
        if cand.startswith("http"):
            found.add(to_origin(cand))
for u in re.findall(r'url\(\s*["\x27]?(https?://[^)"\x27\s]+)', html):
    found.add(to_origin(u))
found.discard(None)

sys.stdout.write("        found: %s\n        declared: %s\n" % (sorted(found) or "[]", sorted(declared) or "[]"))
undeclared = found - declared
if undeclared:
    sys.stdout.write("        undeclared: %s\n" % sorted(undeclared))
    sys.exit(1)
PY
then pass "external-origin resource refs all declared"
else bad "undeclared external origin in index.html (see found/declared above)"; fi

# Runtime network calls are a separate, unconditional claim: the recorder makes none.
if grep -nE 'fetch\(|XMLHttpRequest|EventSource' "$DIR/index.html" >/dev/null 2>&1; then
  bad "runtime network call (fetch/XHR/EventSource) in index.html — the recorder makes none"
  grep -nE 'fetch\(|XMLHttpRequest|EventSource' "$DIR/index.html" | head -5
else pass "no runtime network calls (fetch/XHR/EventSource) in index.html"; fi

if grep -nE '(src|href)="/' "$DIR/index.html" >/dev/null 2>&1; then bad "absolute-root asset ref (breaks subpath hosting)"; else pass "all asset refs relative"; fi

# 6. no secret-pattern material shipped
if grep -rnE 'BEGIN (RSA |EC |OPENSSH )?PRIVATE KEY|AKIA[0-9A-Z]{16}|(api_?key|secret|password)\s*[:=]\s*["'"'"'][^"'"'"']{8,}' "$DIR/index.html" "$DIR/sw.js" >/dev/null 2>&1; then
  bad "possible secret material in shipped assets"; else pass "no secret patterns"; fi

# 7. no asset exceeds the lowest host's per-file limit
for f in "${REQUIRED[@]}"; do
  if [ ! -f "$DIR/$f" ]; then bad "size unknown (missing): $f"; continue; fi
  sz=$(wc -c < "$DIR/$f" | tr -d ' ')
  if [ "$sz" -le "$MAX_BYTES" ]; then pass "size ok ($sz b): $f"; else bad "over $MAX_BYTES b: $f"; fi
done

# 7b. service-worker navigation safety. Navigation requests use redirect mode
# "manual", so a response with .redirected set is rejected by the browser
# (ERR_FAILED). Cloudflare Pages 308s /index.html -> /, and the redirected flag
# SURVIVES storage in the Cache API (w3c/ServiceWorker#737) — so precaching that
# URL poisons the cached shell as well as the network path. Require: a navigate
# branch, no ./index.html in SHELL, and a redirect-stripping rebuild.
if [ -f "$DIR/sw.js" ]; then
  grep -qE "mode === '(navigate)'" "$DIR/sw.js" && pass "sw handles navigations" || bad "sw.js has no navigate branch"
  if sed -n '/const SHELL = \[/,/\]/p' "$DIR/sw.js" | grep -q "index.html"; then
    bad "sw SHELL precaches ./index.html (host 308s it; cached response stays redirect-flagged)"
  else pass "sw shell avoids the redirecting url"; fi
  grep -q '\.redirected' "$DIR/sw.js" && grep -q 'new Response(' "$DIR/sw.js" \
    && pass "sw strips the redirect flag" || bad "sw does not rebuild redirected responses"
else bad "sw.js missing"; fi

# 8. every route declared in site/routes.txt is backed by a real file. The
# neutral manifest is the contract; a route listed there with nothing behind it
# is a 404 waiting to happen on whichever host we move to next.
if [ -f site/routes.txt ]; then
  rmiss=0
  while IFS= read -r route; do
    case "$route" in ""|\#*) continue ;; esac
    rel="${route#/}"; [ -z "$rel" ] && rel="index.html"
    [ -f "$DIR/$rel" ] || { bad "declared route has no file: $route"; rmiss=$((rmiss+1)); }
  done < site/routes.txt
  [ "$rmiss" -eq 0 ] && pass "all declared routes backed by files"
else
  bad "site/routes.txt missing (neutral route manifest is required)"
fi

# 9. the generated Cloudflare adapter must be present in a packaged artifact.
# Rendered from site/headers.yaml; if it silently no-ops, the no-cache intent on
# sw.js never reaches the host and clients pin to stale logic.
if [ "$DIR" != "." ]; then
  if [ -s "$DIR/_headers" ] && grep -qE '^/sw\.js$' "$DIR/_headers"; then pass "adapter _headers rendered (sw.js rule present)"
  else bad "_headers missing or has no /sw.js rule"; fi
fi

echo
if [ "$fail" -eq 0 ]; then echo "VERIFY: PASS"; else echo "VERIFY: FAIL ($fail)"; fi
[ "$fail" -eq 0 ]
